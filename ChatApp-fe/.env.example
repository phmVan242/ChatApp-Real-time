# Copy sang .env.local cho máy của bạn:  cp .env.example .env.local

# ─── Backend cho dev server proxy ────────────────────────────────────
# Chỉ dùng phía server (không bị nhúng vào bundle), dev server sẽ proxy
# /api và /ws tới địa chỉ này.
#
#   backend chạy cùng máy        -> http://localhost:8080
#   backend chạy máy khác trong LAN -> http://192.168.1.20:8080
#   backend public qua tunnel    -> https://abc123.ngrok-free.app
VITE_BACKEND_URL=http://localhost:8080

# ─── Gọi thẳng backend (bỏ trống = đi qua proxy, khuyến nghị) ────────
# Chỉ set khi trình duyệt cần gọi thẳng backend. Khi đó backend phải
# cho phép origin của FE trong CORS_ALLOWED_ORIGINS.
# VITE_API_BASE_URL=https://api.example.com

# Endpoint SockJS/STOMP (mặc định "/ws" — tương đối, đi qua proxy)
# VITE_WS_URL=/ws
