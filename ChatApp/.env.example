# Copy sang .env rồi điền giá trị thật:  cp .env.example .env
APP_NAME=ChatApp

# ─── MySQL ───────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=chatapp
DB_USERNAME=root
DB_PASSWORD=doi_thanh_mat_khau_that

SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# ─── CORS / WebSocket ────────────────────────────────────────────────
# Danh sách origin pattern, phân tách bằng dấu phẩy. Hỗ trợ wildcard.
# Dev  : *
# Prod : https://chat.example.com,https://*.vercel.app
CORS_ALLOWED_ORIGINS=*

# ─── JWT ─────────────────────────────────────────────────────────────
